# ─────────────────────────────────────────────────────────────────────────────
# Kairos — configuration. Copier ce fichier en .env.local puis compléter.
# Toutes ces variables restent côté serveur : n'utilisez jamais le préfixe
# NEXT_PUBLIC_ pour un secret.
# ─────────────────────────────────────────────────────────────────────────────

# --- API sportive -------------------------------------------------------------
# Laisser vide pour utiliser le provider de DÉMONSTRATION (données fictives).
# Fournisseur supporté : api-football (https://www.api-football.com)
SPORTS_API_PROVIDER=
SPORTS_API_KEY=
SPORTS_API_URL=https://v3.football.api-sports.io
# Identifiants de ligues séparés par des virgules (ex. 61 = Ligue 1, 39 = Premier League, 140 = LaLiga)
SPORTS_API_LEAGUES=
# Saison (année de début), ex. 2026
SPORTS_API_SEASON=
# Identifiant de bookmaker pour les cotes (optionnel)
SPORTS_API_BOOKMAKER=
# Durée du cache des réponses (secondes)
SPORTS_API_CACHE_SECONDS=300

# --- IA explicative (optionnel) -----------------------------------------------
# Sans clé, les explications sont produites par un générateur de texte déterministe.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high
LLM_EFFORT=low

# --- Stockage -----------------------------------------------------------------
# Sans DATABASE_URL : fichier JSON local dans DATA_DIR.
# Exemple : postgresql://kairos:kairos@localhost:5432/kairos
DATABASE_URL=
# file | postgres (déduit automatiquement si vide)
STORAGE_DRIVER=
DATA_DIR=.data

# --- Sécurité -----------------------------------------------------------------
# Protège toute l'application par un mot de passe (recommandé si exposée en ligne)
APP_ACCESS_PASSWORD=
# Secret de signature des sessions (32+ caractères aléatoires, ex. `openssl rand -hex 32`)
APP_SESSION_SECRET=

# --- Divers -------------------------------------------------------------------
APP_TIMEZONE=Europe/Paris
LIVE_POLL_INTERVAL_SECONDS=15
BACKTEST_DAYS=45
